rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Manuais - qualquer utilizador autenticado pode fazer upload
    // A leitura é restrita ao autor ou utilizadores com acesso
    match /manuals/{manualId}/{fileName} {
      // Qualquer utilizador autenticado pode fazer upload (create)
      allow create: if request.auth != null;
      
      // Leitura e atualização: apenas o autor (verificado via Firestore não é possível aqui,
      // então permitimos a leitura a qualquer utilizador autenticado)
      allow read, update, delete: if request.auth != null;
    }
    
    // Avatars de utilizador
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Ficheiros temporários (apenas o próprio utilizador)
    match /temp/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}